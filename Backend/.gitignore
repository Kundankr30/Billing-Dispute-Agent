# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
out/
build/
*.tgz

# ── Environment / secrets ─────────────────────────────────────────────────────
# Never commit real credentials — use .env.example as a template instead
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Service account & key files ───────────────────────────────────────────────
# Google / Firebase service-account JSON files contain private keys
*.json
# Re-allow non-sensitive JSON (tsconfig etc.) by pattern — override below:
!tsconfig*.json
!package.json
!package-lock.json

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
*.lcov

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Caches ────────────────────────────────────────────────────────────────────
.eslintcache
.cache/
.turbo/

# ── Bun ───────────────────────────────────────────────────────────────────────
# bun.lock is the lockfile — commit it (same as package-lock.json)
# Bun's cache directory
.bun-cache/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.pem
